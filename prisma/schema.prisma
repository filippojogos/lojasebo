generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id            Int      @id @default(autoincrement())
  nome          String
  preco         Float
  precoOriginal Float?
  categoria     String
  subcategoria  String?
  imagem        String?
  tag           String?
  descricao     String?
  sku           String?
  rating        Float?
  estoque       Int      @default(1)
  galeria       String   // Armazenado como JSON string
  
  // Shipping Dimensions
  weight        Float    @default(0.3) // kg
  width         Float    @default(15)  // cm (Changed to Float)
  height        Float    @default(5)   // cm (Changed to Float)
  depth         Float    @default(20)  // cm (Changed to Float)

  createdAt     DateTime @default(now())
}

model User {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String   // Password hash
  telefone  String?
  cpf       String?
  endereco  String?  // JSON string
  cartoes   String?  // JSON string e.g. [{id, number, ...}]
  
  orders    Order[]
  createdAt DateTime @default(now())
}

model Order {
  id        Int      @id @default(autoincrement())
  total     Float
  lucro     Float?
  status    String   // 'pago', 'enviado', etc.
  data      DateTime @default(now())
  pagamento String?
  
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  
  items     String   // JSON string com os itens do pedido
}

model PopupConfig {
  id        Int      @id @default(autoincrement())
  active    Boolean  @default(true)
  type      String   @default("maintenance") // 'maintenance' or 'image'
  imageUrl  String?
  linkUrl   String?
  updatedAt DateTime @updatedAt
}

model Banner {
  id        Int      @id @default(autoincrement())
  title     String?
  desc      String?
  link      String?
  image     String?
  bgColor   String?  @default("#333333")
  duration  Int      @default(5)
  order     Int      @default(0)
  active    Boolean  @default(true)
}

model HomeConfig {
  id                 Int      @id @default(autoincrement())
  mainHighlights     String   @default("[]") // JSON List of IDs
  categoryHighlights String   @default("{}") // JSON Object { "Livros": [1,2], ... }
  updatedAt          DateTime @updatedAt
}
