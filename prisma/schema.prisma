generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://neondb_owner:npg_JKqYxw0NTFm7@ep-square-sky-acnff39t-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
}

model Product {
  id            Int      @id @default(autoincrement())
  nome          String
  preco         Float
  precoOriginal Float?
  categoria     String
  subcategoria  String?
  imagem        String?
  tag           String?
  descricao     String?
  sku           String?
  rating        Float?
  estoque       Int      @default(1)
  galeria       String   // Armazenado como JSON string
  
  // Shipping Dimensions
  weight        Float    @default(0.3) // kg
  width         Float    @default(15)  // cm (Changed to Float)
  height        Float    @default(5)   // cm (Changed to Float)
  depth         Float    @default(20)  // cm (Changed to Float)

  createdAt     DateTime @default(now())
}

model User {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String   // Password hash
  telefone  String?
  cpf       String?
  endereco  String?  // JSON string
  cartoes   String?  // JSON string e.g. [{id, number, ...}]
  
  orders    Order[]
  createdAt DateTime @default(now())
}

model Order {
  id        Int      @id @default(autoincrement())
  total     Float
  lucro     Float?
  status    String   // 'pago', 'enviado', etc.
  data      DateTime @default(now())
  pagamento String?
  
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  
  items     String   // JSON string com os itens do pedido
}

model PopupConfig {
  id        Int      @id @default(autoincrement())
  active    Boolean  @default(true)
  type      String   @default("maintenance") // 'maintenance' or 'image'
  imageUrl  String?
  linkUrl   String?
  updatedAt DateTime @updatedAt
}

model Banner {
  id        Int      @id @default(autoincrement())
  title     String?
  desc      String?
  link      String?
  image     String?
  bgColor   String?  @default("#333333")
  duration  Int      @default(5)
  order     Int      @default(0)
  active    Boolean  @default(true)
}

model HomeConfig {
  id                 Int      @id @default(autoincrement())
  mainHighlights     String   @default("[]") // JSON List of IDs
  categoryHighlights String   @default("{}") // JSON Object { "Livros": [1,2], ... }
  updatedAt          DateTime @updatedAt
}

model VisitorLog {
  id        Int      @id @default(autoincrement())
  ipHash    String   @unique // Unique per day if we clear or scoped. Actually let's just log. Better: ipHash + day unique constraint?
  // Let's just store simple logs and count unique ipHash where date = today in query.
  // Actually, to prevent massive table growth, let's keep it simple: dateString + ipHash unique
  
  day       String   // "YYYY-MM-DD"
  userAgent String?
  createdAt DateTime @default(now())
  
  @@unique([day, ipHash])
}
