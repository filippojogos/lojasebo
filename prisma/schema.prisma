generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id            Int      @id @default(autoincrement())
  nome          String
  preco         Float
  precoOriginal Float?
  categoria     String
  subcategoria  String?
  imagem        String?
  tag           String?
  descricao     String?
  sku           String?
  rating        Float?
  estoque       Int      @default(1)
  galeria       String   // Armazenado como JSON string
  createdAt     DateTime @default(now())
}

model User {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String   // Password hash
  telefone  String?
  cpf       String?
  endereco  String?  // JSON string
  cartoes   String?  // JSON string e.g. [{id, number, ...}]
  
  orders    Order[]
  createdAt DateTime @default(now())
}

model Order {
  id        Int      @id @default(autoincrement())
  total     Float
  lucro     Float?
  status    String   // 'pago', 'enviado', etc.
  data      DateTime @default(now())
  pagamento String?
  
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  
  items     String   // JSON string com os itens do pedido
}
